<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF0F8"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis movimientos"
        android:textColor="#203451"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnVolverInicio"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:text="← Volver a Inicio"
        android:textSize="13sp"
        android:textAllCaps="false"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consulta tus ingresos y gastos"
        android:textColor="#71829D"
        android:textSize="13sp"
        android:layout_marginTop="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnTodos"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="Todos"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minWidth="0dp"/>

        <Button
            android:id="@+id/btnIngresos"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:text="Ingresos"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minWidth="0dp"/>

        <Button
            android:id="@+id/btnGastos"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="Gastos"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minWidth="0dp"/>
    </LinearLayout>

    <!-- Búsqueda de gastos por ID -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <EditText
            android:id="@+id/edtBuscarGastoId"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/fondo_campo_registro"
            android:paddingHorizontal="12dp"
            android:hint="Buscar gasto por ID"
            android:inputType="number"
            android:textColor="#203451"
            android:textColorHint="#9AA9BD"/>

        <Button
            android:id="@+id/btnBuscarGasto"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Buscar"
            android:textAllCaps="false"
            android:minWidth="0dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/txtResumenIngresos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ingresos: Q 0.00"
            android:textColor="#177354"
            android:textStyle="bold"
            android:textSize="12sp"
            android:maxLines="2"/>

        <TextView
            android:id="@+id/txtResumenGastos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gastos: Q 0.00"
            android:textColor="#BD453E"
            android:textStyle="bold"
            android:textSize="12sp"
            android:maxLines="2"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMovimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="10dp"/>

</LinearLayout>