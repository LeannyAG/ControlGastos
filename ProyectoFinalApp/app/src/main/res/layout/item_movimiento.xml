<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/txtIconoMovimiento"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="#EAF0F8"
        android:text="●"
        android:textSize="20sp"
        android:textColor="#315FA9"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/txtDescripcionMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textColor="#203451"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txtDetalleMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría • Fecha"
            android:textColor="#71829D"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtMontoMovimiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Q 0.00"
        android:textColor="#177354"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:gravity="end"/>

</LinearLayout>